{
  "name": "formforge-fitness-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "npm run check:model && npm run check:anatomy && vinext build && node scripts/prepare-sites-build.mjs",
    "check:model": "node scripts/check-scientific-model.mjs",
    "check:anatomy": "node scripts/check-anatomy-deformation.mjs",
    "start": "vinext start",
    "dev:next": "next dev --webpack",
    "build:next": "next build --webpack",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@fontsource/manrope": "latest",
    "@fontsource/space-grotesk": "latest",
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "@vinext/cloudflare": "^1.0.0-beta.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.30",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "latest",
    "vinext": "^1.0.0-beta.4",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "type": "module"
}
